# Server Configurations
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For Local MongoDB: mongodb://127.0.0.1:27017/devreview_ai
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/devreview_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/devreview_ai?retryWrites=true&w=majority

# JWT Token Cryptography
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini API Credentials
# Replace with your actual Gemini API Key to run real reviews.
# If left as 'placeholder', the application will run in simulated Mock Review Mode.
GEMINI_API_KEY=placeholder
